# Copiar a .env (local) y a .dev.vars (Wrangler). NUNCA subir valores reales al repositorio.
# En staging y producción los secretos se cargan con `wrangler pages secret put NOMBRE`.
# Todo secreto o variable nueva se documenta aquí, sin valor.

APP_ENV=development                 # development | staging | production
PUBLIC_BASE_URL=http://localhost:4321

# Base de datos (Neon o Postgres local)
DATABASE_URL=

# Sesiones (generar con: openssl rand -base64 48)
SESSION_SECRET=

# Anti-bots (Cloudflare Turnstile). La clave del sitio es pública; la secreta, no.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Archivos (Cloudflare R2)
R2_BUCKET=
PUBLIC_MEDIA_BASE_URL=

# Límites de frecuencia (sal para anonimizar IPs; generar con openssl)
RATE_LIMIT_SALT=

# Opcionales
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_CF_ANALYTICS_TOKEN=          # público
